# Copy to .env and change every password before deploying.
MYSQL_DATABASE=student_registry
MYSQL_USER=registry
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too

# Port the site is served on (80 for a plain EC2 box)
WEB_PORT=80

# Only needed when the UI and API live on different origins
APP_CORS_ALLOWED_ORIGINS=http://localhost
